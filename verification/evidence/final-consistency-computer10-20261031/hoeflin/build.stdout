Setup
   [mkdir]        object directory for project Hoeflin
   [mkdir]        exec directory for project Hoeflin
Compile
   [Ada]          hoeflin_calculations.adb
   [Ada]          hoeflin_simulation.adb
   [Ada]          hoeflin_core.adb
   [Ada]          normal_support.adb
Bind
   [gprbind]      hoeflin_calculations.bexch
   [Ada]          hoeflin_calculations.ali
   [gprbind]      hoeflin_simulation.bexch
   [Ada]          hoeflin_simulation.ali
Link
   [link]         hoeflin_calculations.adb
   [link]         hoeflin_simulation.adb
