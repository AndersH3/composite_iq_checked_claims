--  Isolated SPARK/GNATprove 16 smoke project; AI-assisted fixture.
--  This project contains no main program and tests formal proof only.
--  The driver script copies it and its sources to a disposable directory,
--  so no artifacts are left in the project working tree.
project Spark_Smoke is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Source_Files use ("bounded_counts.ads", "bounded_counts.adb");
   for Object_Dir use "obj";

   package Compiler is
      --  Ada 2022 with executable assertion and overflow checking.
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato");
   end Compiler;
end Spark_Smoke;
