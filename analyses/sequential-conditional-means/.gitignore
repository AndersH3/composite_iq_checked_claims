# LaTeX intermediates; the final PDF is intentionally versioned.
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv
*.nav
*.snm
*.vrb

# Local PDF rendering files.
tmp/

# Rebuildable Ada objects and executables; evidence is stored separately.
ada/obj*/
ada/bin/
ada/bin-proof/
ada/results/
ada/tmp/

# Native verification logs are scientific evidence, not LaTeX intermediates.
!evidence/**/*.log
!evidence/**/*.out

# Retain Dask-driven XeLaTeX build logs alongside their report data.
!simulation-data/*.log
