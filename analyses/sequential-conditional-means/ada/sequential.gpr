-- Reuse the repository's contracted generator and its existing numerical
-- boundary rather than maintaining a second random-number implementation.
project Sequential is
   for Source_Dirs use ("src", "../../hoeflin-ferguson/ada/src");
   for Source_Files use
     ("sequential_core.ads", "sequential_core.adb",
      "sequential_experiments.ads", "sequential_experiments.adb",
      "sequential_sampling.ads", "sequential_sampling.adb",
      "sequential_run.adb",
      "hoeflin_core.ads", "hoeflin_core.adb",
      "hoeflin_boundary_models.ads", "hoeflin_boundary_models.adb",
      "normal_support.ads", "normal_support.adb");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("sequential_run.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-O2", "-g",
         "-msse2", "-mfpmath=sse");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-lm");
   end Linker;
end Sequential;
