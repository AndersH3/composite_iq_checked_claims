--  Sequential uses only its specialized Ada sources and canonical library.
--  No Hoeflin report package is loaded: generator and checked numerical
--  boundaries are independently shared by both report-specific adapters.
project Sequential is
   for Source_Dirs use ("src", "../../../library/spark/src");
   for Source_Files use
     ("sequential_core.ads", "sequential_core.adb",
      "sequential_experiments.ads", "sequential_experiments.adb",
      "sequential_sampling.ads", "sequential_sampling.adb",
      "sequential_run.adb",
      "shared_equicorrelation.ads", "shared_equicorrelation.adb",
      "shared_normal_sampling.ads", "shared_normal_sampling.adb");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("sequential_run.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-O2", "-g",
         "-msse2", "-mfpmath=sse");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-lm");
   end Linker;
end Sequential;
