project Hoeflin_Proof is
   for Source_Dirs use ("src");
   for Source_Files use ("hoeflin_core.ads", "hoeflin_core.adb");
   for Object_Dir use "obj-proof";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnato", "-msse2", "-mfpmath=sse");
   end Compiler;
end Hoeflin_Proof;
