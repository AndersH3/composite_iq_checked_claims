project Towers_Proof is
   for Source_Dirs use ("src");
   for Source_Files use ("admission_core.ads", "admission_core.adb",
                         "normal_model.ads", "normal_model.adb",
                         "towers_engine.ads", "towers_engine.adb",
                         "towers_io.ads", "towers_io.adb", "towers_demo.adb",
                         "towers_boundary_models.ads", "towers_boundary_models.adb",
                         "towers_io_models.ads", "towers_io_models.adb");
   for Object_Dir use "proof_obj";
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnato", "-fno-fast-math",
         "-msse2", "-mfpmath=sse");
   end Compiler;
end Towers_Proof;
